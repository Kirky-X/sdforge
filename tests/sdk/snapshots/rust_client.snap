impl<T: Transport> SdforgeClient<T> {
    /// 以服务基址与传输实现构造。
    pub fn new(base_url: impl Into<String>, transport: T) -> Self {
        let mut base_url = base_url.into();
        while base_url.ends_with('/') {
            base_url.pop();
