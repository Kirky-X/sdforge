    async fn call(&self, method: &str, path: &str, body: Option<String>) -> Result<String, ClientError> {
        let url = format!("{}{}", self.base_url, path);
        self.transport.execute(method, &url, body).await.map_err(ClientError)
    }

    /// List users（`GET /api/v1/users`）。
    pub async fn get_api_v1_users(
