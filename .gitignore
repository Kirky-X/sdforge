# =============================================================================
# sdforge — .gitignore
# 结构:统一公共段(7 仓库同源,见 base/CONFIG_BASELINE.md)+ 仓库特有段
# 注意:Cargo.lock 与 rust-toolchain.toml 纳入版本控制,不再忽略
# =============================================================================

# =============================================================================
# 统一公共段
# =============================================================================

# --- Build artifacts (Rust) ---
/target
/debug
/release
**/*.rs.bk

# Cargo 本地覆盖(.cargo/config.toml 等机器特定配置)
.cargo/

# --- Code coverage ---
coverage/
*.profraw
*.profdata
*.gcda
*.gcno
lcov.info
*.lcov
htmlcov/
tarpaulin-report.html

# --- IDE & Editors ---
.idea/
.vscode/
.vscodeignore
.idea_modules/
*.code-workspace
*.sublime-*
.nvimrc
*.swp
*.swo
*~
.un~
Session.vim
.netrwhist

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
*.log
logs/
*.pid
*.seed

# --- Temporary files ---
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# --- Environment & secrets (never commit) ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.crt
*.secret
*.credentials
.pre-commit-check.log

# --- Local config / AI assistant files (kept local only) ---
.local-registry/
.claude/
.qoder/
.opencode/
.cursor/
.aider/
.continue/
.codeium/
.iflow/
.sisyphus/
.github/copilot/
CLAUDE.md
IFLOW.md
GEMINI.md
CODEIUM.md
AGENTS.md
openspec/
specmark/
**/specmark/
.codenexus/
**/.codenexus/
strix_runs

# --- Isolated dev workspaces ---
.worktrees/
.gitnexus

# --- Reviews / security scan artifacts (never tracked) ---
reviews/
.mimosa/

# --- WorkBuddy AI local notes ---
.workbuddy-ai/

# =============================================================================
# 仓库特有段(sdforge)
# =============================================================================

# --- Rust build byproducts ---
*.rlib
*.rmeta
*.so
*.a
*.o
*.dylib
*.dll
*.exe
*.bin
*.app

# --- Generated API documentation(根目录生成物;src/openapi/ 源码不受影响) ---
/openapi/
/swagger/

# --- 本仓内部文档草稿(定稿前不入库) ---
doc/
docs/book/
docs/ettara.md
docs/prd.md
docs/task.md
docs/tdd.md
docs/test.md
docs/uat.md
docs/superpowers/

# --- 本地开发笔记 ---
DEV_NOTES.md
TODO.md
CODE_REVIEW_REPORT.md
di.md

# --- 本地 CI / 测试 / 基准产物 ---
.github/workflows/tests/
.github/workflows/local/
benches/results/
load-test-results/
test-results/

# --- 本地数据库文件 ---
*.db
*.sqlite
*.sqlite3

# --- 生成代码 ---
*.generated.rs
