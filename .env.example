# Environment Variables Configuration
# Copy this file to .env and customize
#
# The framework itself reads only the SDFORGE_* variables below.
# Server settings (host / port / body limit / rate limit / auth / cache)
# come from the TOML file passed to SdForgeConfig — see examples/config/.

# i18n language override (wins over LC_ALL / LC_MESSAGES / LANG)
SDFORGE_LANG=en

# CLI credentials, checked by CliBuilder::with_auth_verifier when the
# `security` feature and a verifier are configured
SDFORGE_TOKEN=
SDFORGE_API_KEY=

# Audit log HMAC signing key (optional; set to a random value of at least
# 32 bytes, e.g. `openssl rand -hex 32`. Unset / empty = audit logs unsigned)
SDFORGE_AUDIT_SIGNING_KEY=

# --- Example apps only (not read by the framework library) ---
# Demo server port in examples (default 3000)
HTTP_PORT=3000
# Swagger demo port in examples (default 8080)
SDFORGE_HTTP_PORT=8080
